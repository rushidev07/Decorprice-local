<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Mageplaza_Core::css/magnific-popup.css"/>
    </head>
    <referenceContainer name="alert.urls">
        <block class="Mageplaza\NameYourPrice\Block\Product\View\Bargain" name="mppricebargain.bargain.view" template="Mageplaza_NameYourPrice::product/view/bargain.phtml" ifconfig="mppricebargain/general/enabled">
            <block class="Mageplaza\NameYourPrice\Block\Product\View\Bargain" name="mppricebargain.bargain.button" as="bargain_button" template="Mageplaza_NameYourPrice::product/view/button.phtml">
                <block class="Mageplaza\NameYourPrice\Block\Product\View\Bargain" name="mppricebargain.bargain.form" as="bargain_form" template="Mageplaza_NameYourPrice::product/view/form.phtml"/>
            </block>
            <block class="Mageplaza\NameYourPrice\Block\Product\View\Bargain" name="mppricebargain.your.bargain" as="your_bargain" template="Mageplaza_NameYourPrice::product/view/customer_bargain.phtml"/>
        </block>
    </referenceContainer>
</page>