<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="mppricebargain_requests_listing_data_source" xsi:type="string">Mageplaza\NameYourPrice\Model\ResourceModel\Requests\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="Mageplaza\NameYourPrice\Model\ResourceModel\Requests\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">mageplaza_mppricebargain_requests</argument>
            <argument name="resourceModel" xsi:type="string">Mageplaza\NameYourPrice\Model\ResourceModel\Requests</argument>
        </arguments>
    </virtualType>
    <type name="Mageplaza\Osc\Model\CheckoutManagement">
        <plugin name="mppricebargain_check_bargain_qty_osc" type="Mageplaza\NameYourPrice\Plugin\Model\CheckUpdateQty"/>
    </type>
    <type name="Magento\Quote\Model\Quote\Address\Total">
        <plugin name="mppricebargain_set_all_total_amount" type="Mageplaza\NameYourPrice\Plugin\Model\SetAllTotalAmount"/>
    </type>
</config>
