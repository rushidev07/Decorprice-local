<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Bundle\Block\Catalog\Product\View\Type\Bundle\Option">
        <plugin name="mppricebargain_set_selected_bundle_product" type="Mageplaza\NameYourPrice\Plugin\Block\Catalog\Product\View\Type\Bundle\Option"/>
    </type>
    <type name="Magento\Checkout\Controller\Cart\Add">
        <plugin name="mppricebargain_check_bargain_qty" type="Mageplaza\NameYourPrice\Plugin\Controller\Cart\AddToCart"/>
    </type>
    <type name="Mageplaza\Osc\Controller\Index\Index">
        <plugin name="mppricebargain_check_qty_add_url" type="Mageplaza\NameYourPrice\Plugin\Controller\CheckOSCQty"/>
    </type>
    <type name="Magento\Quote\Model\Quote\Item\AbstractItem">
        <plugin name="mppricebargain_set_price_item" type="Mageplaza\NameYourPrice\Plugin\Model\SetPriceItem"/>
    </type>
    <type name="Magento\Customer\CustomerData\SectionPoolInterface">
        <arguments>
            <argument name="sectionSourceMap" xsi:type="array">
                <item name="bargainData" xsi:type="string">Mageplaza\NameYourPrice\CustomerData\BargainSection</item>
            </argument>
        </arguments>
    </type>
</config>
