var progressStartUrl, progressStatusUrl, progressResultUrl;
var progressCreateBatchUrl = '<?php echo $this->getUrl('udpo/vendor/UdpoLabelBatchCreate') ?>';
var progressStatusUrlTpl = '<?php echo $this->getUrl('udpo/vendor/UdpoLabelBatchProgress', ['batch_id'=>'{{id}}','_escape_params'=>false]) ?>';
var progressResultUrlTpl = '<?php echo $this->getUrl('udpo/vendor/ReprintLabelBatch', ['batch_id'=>'{{id}}','_escape_params'=>false]) ?>';

window.udpoProgressCreateBatch = function(batchId) {
    var batchId;
    new Ajax.Request(progressCreateBatchUrl, {
        asynchronous: false,
        method: 'post',
        onFailure: function(transport){
            udpoProgressShowMessage('<?php echo $this->escapeJsQuote(__('Unexpected Error'))?>', true);
        },
        onComplete: function(transport) {
            var responseText = transport.responseText;
            if (responseText.isJSON()) {
                var response = responseText.evalJSON()
                if (response.error) {
                    alert(response.message);
                }
                if (response.ajaxExpired && response.ajaxRedirect) {
                    setLocation(response.ajaxRedirect);
                }
                batchId = response.id;
            } else {
                alert('<?php echo $this->escapeJsQuote(__('Unexpected Error'))?>');
            }
        }
    });
    return batchId;
};
window.udpoProgressStart = function() {
    var batchId = udpoProgressCreateBatch();
    if (!batchId) return;
    $('modal_close').hide();
    $('modal_try_later').show();
    unirgyGetModal().stickyModal = true;
    unirgyGetModal().isProcessEsc = false;
    unirgyShowThisModal('udpo_progress_modal');
    $('udpo_progress_modal_grid').show();
    $('udpo_progress_modal_error').hide();
    udpoProgressInit();
    new Ajax.Request(progressStartUrl+'&batch_id='+batchId, {
        method: 'post',
        onFailure: function(transport){
            if (transport.status!=504 && transport.status!=524) {
                udpoProgressShowMessage('<?php echo $this->escapeJsQuote(__('Unexpected Error'))?>', true);
            }
        },
        onComplete: function(transport) {
            var responseText = transport.responseText;
            if (transport.status!=504 && transport.status!=524) {
                if (responseText.isJSON()) {
                    var response = responseText.evalJSON()
                    if (response.error) {
                        udpoProgressShowMessage(response.message, true);
                    }
                    if (response.ajaxExpired && response.ajaxRedirect) {
                        setLocation(response.ajaxRedirect);
                    }
                } else {
                    udpoProgressShowMessage('<?php echo $this->escapeJsQuote(__('Unexpected Error'))?>', true);
                }
            }
        }
    });
    var loaderEl = $$('.loading-mask');
    if (loaderEl && loaderEl[0]) {
        loaderEl[0].hide();
    }
    setTimeout(function () {
        progressStatusUrl = udpoProgressStatusUrl(batchId);
        progressResultUrl = udpoProgressResultUrl(batchId);
        udpoProgressLoop();
    }, 3000);
};
window.udpoProgressResultUrl = function (id) {
    return udpoProgressUrl(progressResultUrlTpl, id);
};
window.udpoProgressStatusUrl = function (id) {
    return udpoProgressUrl(progressStatusUrlTpl, id);
};
window.udpoProgressUrl = function (urlTpl, id) {
    var url = new Template(
        urlTpl,
        /(^|.|\r|\n)(\{\{(.*?)\}\})/
    );
    return url.evaluate({id:id});
};
window.udpoProgressLoop = function() {
    new Ajax.Request(progressStatusUrl, {
        method: 'post',
        onFailure: function(transport){
            udpoProgressShowMessage('<?php echo $this->escapeJsQuote(__('Unexpected Progress Check Error'))?>', true);
        },
        onComplete: function(transport) {
            var responseText = transport.responseText;
            if (responseText.isJSON()) {
                var response = responseText.evalJSON();
                if (response.error) {
                    udpoProgressShowMessage(response.message, true);
                }
                if(response.ajaxExpired && response.ajaxRedirect) {
                    setLocation(response.ajaxRedirect);
                } else if (!response.error) {
                    udpoProgressUpdate(response);
                }
            } else {
                udpoProgressShowMessage('<?php echo $this->escapeJsQuote(__('Unexpected Progress Check Error'))?>', true);
            }
        }
    });
    var loaderEl = $$('.loading-mask');
    if (loaderEl && loaderEl[0]) {
        loaderEl[0].hide();
    }
};
window.udpoProgressShowMessage = function(message, isError) {

    $('udpo_progress_modal_error').show();
    var msg = $('udpo_progress_modal_error').down('.message');
    if (isError) {
        msg.update('<span class="error">' + message + '</span>');
        $('udpo_progress_modal_grid').hide();
    } else {
        msg.update('<span class="success">' + message + '</span>');
    }
};
window.udpoProgressInit = function()
{
    _udpoProgressUpdate('udpo_progress_modal_table', {percent:0});
};
window.udpoProgressUpdate = function(response) {
    var isComplete = true;
    var percent = 100;
    if (response.items_count>0) {
        percent = Math.round(response.items_processed/response.items_count*100);
    }
    if (response.status!='complete') {
        isComplete = false;
        if (percent==100) {
            percent = 99;
        }
    }
    response.percent = percent;
    _udpoProgressUpdate('udpo_progress_modal_table', response);
    if (isComplete) {
        progressResultUrl = udpoProgressResultUrl(response.id);
        unirgyGetModal().hideCurrentModal();
        var ifrId = 'ifr_id_'+(new Date()).getTime();
        if (Prototype.Browser.IE) {
            Element.insert($('download_iframe'), {
                after: '<iframe id="' + ifrId + '" src="' + progressResultUrl
                + '" style="display:none" onreadystatechange="ieDownloadSubmitWrapper(\'' + ifrId + '\')"></iframe>'
            })
        } else {
            Element.insert($('download_iframe'), {
                after: '<iframe id="' + ifrId + '" src="' + progressResultUrl
                + '" style="display:none" onload="afterDownloadSubmit(\'' + ifrId + '\')"></iframe>'
            })
        }
    } else {
        setTimeout(function() {
            udpoProgressLoop();
        }, 3000);
    }
};
window._udpoProgressUpdate = function(containerId, inData) {
    var data = {
        percent: 0
    };
    Object.extend(data, inData);
    var progressSpan = $(containerId).down('.progress').down('.progress_percent');
    var widthPcnt = 1*data.percent+'%';
    progressSpan.update(widthPcnt);
    progressSpan.setStyle({
        backgroundColor: 'green',
        width: widthPcnt
    });
};


