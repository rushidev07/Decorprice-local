<?xml version="1.0" encoding="UTF-8"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="frame-src">
            <values>
                <value id="wesupply_domain_whitelist" type="host">*.wesupply.xyz</value>
                <value id="wesupplylabs_domain_whitelist" type="host">https://wesupplylabs.com</value>
                <value id="nsgpp-frame" type="host">guarantee-cdn.com</value>
            </values>
        </policy>
        <policy id="script-src">
            <values>
                <value id="wesupply_domain_whitelist" type="host">*.cloudflare.com</value>
                <value id="nsgpp-script" type="host">guarantee-cdn.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="nsgpp-image" type="host">guarantee-cdn.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
