<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="sidebar" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="summary" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="totals" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <item name="nsgpp-checkout" xsi:type="array">
                                                            <item name="component" xsi:type="string">WeSupply_Toolbox/js/view/norton_shopping_guarantee/package_protection/checkout/nsgpp_checkout</item>
                                                            <item name="sortOrder" xsi:type="string">95</item>
                                                            <item name="displayArea" xsi:type="string">totals</item>
                                                        </item>
                                                        <item name="nsgpp_fee" xsi:type="array">
                                                            <item name="component" xsi:type="string">WeSupply_Toolbox/js/view/norton_shopping_guarantee/package_protection/checkout/cart/totals/nsgpp_fee</item>
                                                            <item name="sortOrder" xsi:type="string">25</item>
                                                            <item name="config" xsi:type="array">
                                                                <item name="template" xsi:type="string">WeSupply_Toolbox/norton_shopping_guarantee/package_protection/checkout/cart/totals/nsgpp_fee</item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                                <item name="steps" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="shipping-step" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="shippingAddress" xsi:type="array">
                                                    <item name="config" xsi:type="array">
                                                        <item name="shippingMethodItemTemplate" xsi:type="string">WeSupply_Toolbox/wesupply-item-template</item>
                                                        <item name="shippingMethodListTemplate" xsi:type="string">WeSupply_Toolbox/wesupply-list-template</item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template" name="nsgpp_reload_handler">
                <arguments>
                    <argument name="template" xsi:type="string">WeSupply_Toolbox::norton_shopping_guarantee/package_protection/nsgpp_reload_initializer.phtml</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
