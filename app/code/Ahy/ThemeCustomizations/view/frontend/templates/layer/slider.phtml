    $isWidth            = isset($priceData['isWidth']) && $priceData['isWidth'] ? $priceData['isWidth'] : '';
    $isHeight           = isset($priceData['isHeight']) && $priceData['isHeight'] ? $priceData['isHeight'] : '';
    $widthValue         = $isWidth ? $priceData['widthValue'][0] : '';
    $heightValue        = $isHeight ? $priceData['heightValue'][0] : '';
?>

<?php if($isPrice):?>
<div id="slider-range"></div>
<?php elseif($isWidth): ?>
