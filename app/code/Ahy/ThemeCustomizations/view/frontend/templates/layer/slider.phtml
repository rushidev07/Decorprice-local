            <?php endif;?>

            <span class="wp-slider-range-separator">-</span>

            <?php if($priceIsInputType): ?>
                <input type="text" id="width_to" class="wp-width-slider-inp inp-type" style="margin-right: auto;" />
            <?php else : ?>
                <div class="price-value-wrapper">
                    <span class="wp-slider-currency"><?=$priceData['currency']?></span>
                    <span id="width_to" class="wp-width-slider-inp" style="margin-right: auto;"></span>
