<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="product.info.details">
            <block class="Magento\Catalog\Block\Product\View" name="pdf.tab" template="MageNJ_ProductTabs::pdf.phtml" group="detailed_info" >
                <arguments>
                    <argument translate="true" name="title" xsi:type="string">PDFs</argument>
                    <argument name="sort_order" xsi:type="string">30</argument>
                </arguments>
            </block>
        </referenceBlock>
        <referenceBlock name="product.info.details">
            <block class="Magento\Catalog\Block\Product\View" name="video.tab" template="MageNJ_ProductTabs::video.phtml" group="detailed_info" >
                <arguments>
                    <argument translate="true" name="title" xsi:type="string">Video</argument>
                    <argument name="sort_order" xsi:type="string">40</argument>
                </arguments>
            </block>
        </referenceBlock>
        <referenceBlock name="product.info.details">
            <block class="Magento\Catalog\Block\Product\View" name="returnrules.tab" template="MageNJ_ProductTabs::return-rules.phtml" group="detailed_info" >
                <arguments>
                    <argument translate="true" name="title" xsi:type="string">Return Rules</argument>
                    <argument name="sort_order" xsi:type="string">100</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>