<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../../../lib/internal/Magento/Framework/View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="adminhtml.eop.popup.container">
            <block class="Magetrend\Eop\Block\Adminhtml\Popup\Grid" name="adminhtml.newslettrer.subscriber.grid" as="grid">
                <arguments>
                    <argument name="id" xsi:type="string">popupGrid</argument>
                    <argument name="dataSource" xsi:type="object">Magetrend\Eop\Model\ResourceModel\Popup\Collection</argument>
                    <argument name="default_sort" xsi:type="string">entity_id</argument>
                    <argument name="default_dir" xsi:type="string">desc</argument>
                    <argument name="use_ajax" xsi:type="string">1</argument>
                    <argument name="grid_url" xsi:type="url" path="eop/*/grid">
                        <param name="_current">1</param>
                    </argument>
                </arguments>

                <block class="Magento\Backend\Block\Widget\Grid\ColumnSet" name="adminhtml.newslettrer.subscriber.grid.columnSet" as="grid.columnSet">
                    <arguments>
                        <argument name="rowUrl" xsi:type="array">
                            <item name="path" xsi:type="string">eop/*/edit</item>
                            <item name="extraParamsTemplate" xsi:type="array">
                                <item name="id" xsi:type="string">getId</item>
                            </item>
                        </argument>
                    </arguments>

                    <block class="Magento\Backend\Block\Widget\Grid\Column" as="entity_id">
                        <arguments>
                            <argument name="header" xsi:type="string" translate="true">ID</argument>
                            <argument name="index" xsi:type="string">entity_id</argument>

                            <argument name="header_css_class" xsi:type="string">col-id</argument>
                            <argument name="column_css_class" xsi:type="string">col-id</argument>
                        </arguments>
                    </block>
                    <block class="Magento\Backend\Block\Widget\Grid\Column" as="name">
                        <arguments>
                            <argument name="header" xsi:type="string" translate="true">Name</argument>
                            <argument name="index" xsi:type="string">name</argument>
                            <argument name="header_css_class" xsi:type="string">col-name</argument>
                            <argument name="column_css_class" xsi:type="string">col-name</argument>
                        </arguments>
                    </block>

                    <block class="Magento\Backend\Block\Widget\Grid\Column" as="theme">
                        <arguments>
                            <argument name="header" xsi:type="string" translate="true">Theme</argument>
                            <argument name="index" xsi:type="string">theme</argument>
                            <argument name="type" xsi:type="string">options</argument>
                            <argument name="options" xsi:type="array">
                                <item name="basic" xsi:type="array">
                                    <item name="value" xsi:type="string">basic</item>
                                    <item name="label" xsi:type="string" translate="true">Default</item>
                                </item>
                                <item name="label" xsi:type="array">
                                    <item name="value" xsi:type="string">label</item>
                                    <item name="label" xsi:type="string" translate="true">Label</item>
                                </item>
                                <item name="clear" xsi:type="array">
                                    <item name="value" xsi:type="string">clear</item>
                                    <item name="label" xsi:type="string" translate="true">Clear</item>
                                </item>
                                <item name="orange" xsi:type="array">
                                    <item name="value" xsi:type="string">orange</item>
                                    <item name="label" xsi:type="string" translate="true">Orange</item>
                                </item>
                            </argument>
                            <argument name="header_css_class" xsi:type="string">col-theme</argument>
                            <argument name="column_css_class" xsi:type="string">col-theme</argument>
                        </arguments>
                    </block>
                    <block class="Magento\Backend\Block\Widget\Grid\Column" as="content_type">
                        <arguments>
                            <argument name="header" xsi:type="string" translate="true">Content</argument>
                            <argument name="index" xsi:type="string">content_type</argument>
                            <argument name="type" xsi:type="string">options</argument>
                            <argument name="options" xsi:type="array">
                                <item name="newsletter_subscription_form" xsi:type="array">
                                    <item name="value" xsi:type="string">newsletter_subscription_form</item>
                                    <item name="label" xsi:type="string" translate="true">Newsletter Subscription Form</item>
                                </item>
                                <item name="static_block" xsi:type="array">
                                    <item name="value" xsi:type="string">static_block</item>
                                    <item name="label" xsi:type="string" translate="true">Static CMS Block</item>
                                </item>
                                <item name="yes_no_buttons" xsi:type="array">
                                    <item name="value" xsi:type="string">yes_no_buttons</item>
                                    <item name="label" xsi:type="string" translate="true">Yes/No Buttons</item>
                                </item>
                                <item name="contact_form" xsi:type="array">
                                    <item name="value" xsi:type="string">contact_form</item>
                                    <item name="label" xsi:type="string" translate="true">Contact Form</item>
                                </item>


                            </argument>
                            <argument name="header_css_class" xsi:type="string">col-content-type</argument>
                            <argument name="column_css_class" xsi:type="string">col-content-type</argument>
                        </arguments>
                    </block>
                </block>
            </block>
        </referenceBlock>
    </body>
</page>
