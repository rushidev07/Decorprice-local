<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Ced_Houzz::Houzz" title="Houzz">
			<resource id="Ced_Houzz::houzz_products" title="Houzz Products">
				<resource id="Ced_Houzz::houzz_products_index" title="Manage Products"></resource>
				<resource id="Ced_Houzz::houzz_profiles" title="Manage Profile"></resource>
				<resource id="Ced_Houzz::houzz_products_feeds" title="Manage Feeds"></resource>
			</resource>
			<resource id="Ced_Houzz::houzz_orders" title="Houzz">
				<resource id="Ced_Houzz::view_houzz_orders" title="Manage Orders"></resource>
				<resource id="Ced_Houzz::view_failed_imported_houzz_orders_log" title="Manage Failed Orders"></resource>
			</resource>
			<resource id="Ced_Houzz::configurations" title="Houzz Configurations">
				<resource id="Ced_Houzz::configuration" title="Houzz Configuration"></resource>
			</resource>
			<resource id="Ced_Houzz::extra" title="Houzz Extra">
				<resource id="Ced_Houzz::houzz_knowledge_base" title="Houzz Knowledge Base"></resource>
				<resource id="Ced_Houzz::houzz_cron_crongrid" title="Houzz Cron"></resource>
				<resource id="Ced_Houzz::houzz_logs_grid" title="Houzz Logs"></resource>
				<!--<resource id="Ced_Houzz::houzz_categories" title="Houzz Category"></resource>-->
			</resource>
		</resource>
		<resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Ced_Houzz::system_config" title="Houzz Api Config"></resource>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
