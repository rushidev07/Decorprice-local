<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="houzz">

        <job name="ced_houzz_inventory_cron" instance="Ced\Houzz\Cron\UpdateInventory" method="execute">
            <schedule>*/10 * * * *</schedule>
        </job>

        <job name="ced_houzz_orders_cron" instance="Ced\Houzz\Cron\FetchHouzzOrders" method="execute">
            <schedule>*/10 * * * *</schedule>
        </job>

    </group>
</config>
