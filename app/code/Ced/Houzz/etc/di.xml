<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Ced\Houzz\Helper\HouzzHandler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="Ced\Houzz\Helper\HouzzLogger">
        <arguments>
            <argument name="name" xsi:type="string">Houzz</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="system" xsi:type="object">Ced\Houzz\Helper\HouzzHandler</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Config\Model\Config">
        <plugin name="admin_system_config_save_plugin_houzz" type="Ced\Houzz\Plugin\ConfigPlugin" sortOrder="1" disabled="false" />
    </type>
    <!-- <preference for="Magento\Config\Model\Config" type="Ced\Houzz\Model\Adminhtml\Config\Data" /> -->
    <preference for="Magento\Config\Model\Config\SchemaLocator" type="Ced\Houzz\Model\Config\SchemaLocator" />
    <!-- profile view grid -->
    <virtualType name="ProfileDataGridFilterPool" type="Magento\Framework\View\Element\UiComponent\DataProvider\FilterPool">
        <arguments>
            <argument name="appliers" xsi:type="array">
                <item name="regular" xsi:type="object">Magento\Framework\View\Element\UiComponent\DataProvider\RegularFilter</item>
                <item name="fulltext" xsi:type="object">Magento\Framework\View\Element\UiComponent\DataProvider\FulltextFilter</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="ProfileDataGridDataProvider" type="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
        <arguments>
            <argument name="collection" xsi:type="object" shared="false">Ced\Houzz\Model\Resource\Profile\Collection</argument>
            <argument name="filterPool" xsi:type="object" shared="false">ProfileDataGridFilterPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="Ced\Houzz\Model\ResourceModel\Profile\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">houzz_profile</argument>
            <argument name="resourceModel" xsi:type="string">Ced\Houzz\Model\ResourceModel\Profile</argument>
        </arguments>
    </virtualType>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="houzz_profile_index_data_source" xsi:type="string">Ced\Houzz\Model\ResourceModel\Profile\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
</config>